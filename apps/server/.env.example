PORT=4000
NODE_ENV=development
# Lista exata de origens web permitidas, separadas por vírgula.
CLIENT_URL=http://localhost:8081,http://localhost:8082
DATABASE_URL=""
DIRECT_URL=""
# Copie a URI Session pooler (5432) do Supabase.
# Use sslmode=verify-full; se necessário, acrescente sslrootcert com o caminho da CA.
# DIRECT_URL deve usar conexão direta ou Session pooler, com usuário de migrations.

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER=kapa-api
JWT_AUDIENCE=kapa-app
ACCESS_TOKEN_TTL_SECONDS=604800
# URL completa para ambientes hospedados. Use rediss:// quando o provedor oferecer TLS.
REDIS_URL=
# Fallback usado apenas no desenvolvimento local quando REDIS_URL estiver vazia.
REDIS_PORT=6379
REDIS_PASSWORD=kapa

# Configurações Supabase (Storage S3 compatível e Edge Functions)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-supabase
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=kapa-public
SUPABASE_S3_ACCESS_KEY=sua-access-key-supabase
SUPABASE_S3_SECRET_KEY=sua-secret-key-supabase

SALT_SECRET=
GOOGLE_API_ID=
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Configurações de Logging Centralizado (Pino)
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_FREQUENCY=daily
LOG_RETENTION_COUNT=14
