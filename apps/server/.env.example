PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:8081
DATABASE_URL="postgresql://docker:docker@localhost:5432/kapa?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER=kapa-api
JWT_AUDIENCE=kapa-app
ACCESS_TOKEN_TTL_SECONDS=900
REDIS_PORT=6379
REDIS_PASSWORD=kapa
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kapa-public
S3_ACCESS_KEY=kapa
# Credencial somente para desenvolvimento local; use secret manager em produção.
S3_SECRET_KEY=kapa-local-storage-secret
