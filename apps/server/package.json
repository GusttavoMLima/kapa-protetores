{
  "name": "@kapa/server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "docker compose up -d redis && tsx watch src/index.ts",
    "build": "npm run build --workspace=@kapa/shared && prisma generate && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test:k6": "docker compose run --rm k6 run /scripts/smoke-test.js",
    "test:k6:smoke": "docker compose run --rm k6 run /scripts/smoke-test.js",
    "test:k6:load": "docker compose run --rm k6 run /scripts/load-test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@kapa/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@kapa/eslint-config": "*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "private": true
}
