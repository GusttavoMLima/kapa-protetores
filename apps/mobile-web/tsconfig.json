{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/../assets/*.svg": [
        "./src/types/svg.d.ts"
      ],
      "@/../assets/*": [
        "./src/types/images.d.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "nativewind/types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
