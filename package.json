{
  "name": "kapa-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"EXPO,SERVER\" -c \"cyan,green\" \"npm run dev:mobile\" \"npm run dev:server\"",
    "dev:mobile": "npm run start --workspace=apps/mobile-web",
    "dev:server": "npm run dev --workspace=apps/server",
    "start:mobile": "npm run start --workspace=apps/mobile-web",
    "start:server": "npm run start --workspace=apps/server",
    "android": "npm run android --workspace=apps/mobile-web",
    "ios": "npm run ios --workspace=apps/mobile-web",
    "web": "npm run web --workspace=apps/mobile-web",
    "build:server": "npm run build --workspace=apps/server",
    "build:web": "npm run build:web --workspace=apps/mobile-web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
