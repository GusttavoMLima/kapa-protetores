{
  "name": "kapa-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"EXPO,SERVER\" -c \"cyan,green\" \"npm run web\" \"npm run dev:server\"",
    "dev:mobile": "npm run start --workspace=apps/mobile-web",
    "dev:server": "npm run dev --workspace=apps/server",
    "start:mobile": "npm run start --workspace=apps/mobile-web",
    "start:server": "npm run start --workspace=apps/server",
    "android": "npm run android --workspace=apps/mobile-web",
    "ios": "npm run ios --workspace=apps/mobile-web",
    "web": "npm run web --workspace=apps/mobile-web",
    "build:shared": "npm run build --workspace=@kapa/shared",
    "build:server": "npm run build --workspace=apps/server",
    "build:web": "npm run build:web --workspace=apps/mobile-web",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:seed": "npm run prisma:seed --workspace=apps/server",
    "prisma:studio": "npm run prisma:studio --workspace=apps/server",
    "clean:build": "rm -rf apps/mobile-web/android/app/build apps/mobile-web/android/app/.cxx apps/mobile-web/.expo",
    "clean": "npm run clean:build",
    "type-check": "tsc --noEmit --project apps/server/tsconfig.json && tsc --noEmit --project apps/mobile-web/tsconfig.json",
    "test": "npm run test --workspace=@kapa/server && npm run test:animal-model",
    "test:animal-model": "node --import tsx --test apps/mobile-web/tests/animal-management-model.test.mjs apps/mobile-web/tests/api-base-url.test.mjs apps/mobile-web/tests/search-adopt-model.test.mjs",
    "test:k6": "npm run test:k6 --workspace=@kapa/server",
    "test:k6:load": "npm run test:k6:load --workspace=@kapa/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
